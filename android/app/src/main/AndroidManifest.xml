<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:tools="http://schemas.android.com/tools"
          xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Networking for guest programs (socket passthrough) and the mirror speed probe at first start -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The default network's routes go into the guest's routing table (design doc §10) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- PARTIAL_WAKE_LOCK follows the screen-off running policy (the android/service map). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Only for the settings' update check: the installer asks for the app to be allowed to
         install the package it just downloaded; Android keeps the switch itself, off by default -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- localeConfig enables the system language picker on Android 13+; older versions ignore it. -->
    <application
            android:name=".MainApplication"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:allowBackup="false"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:fullBackupContent="false"
            android:localeConfig="@xml/locale_config"
            android:theme="@style/Theme.Tuxport"
            tools:ignore="UnusedAttribute">

        <!-- Settings and the license pages leave out uiMode: they follow the system's dark mode,
             so a change recreates them with the other colours. No activity handles density: a
             display size change recreates it, so the views it built in dp take the new sizes -->

        <activity
                android:name=".MainActivity"
                android:launchMode="singleTask"
                android:theme="@style/Theme.Tuxport.Terminal"
                android:windowSoftInputMode="adjustResize"
                android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
                android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
                android:name=".SettingsActivity"
                android:label="@string/settings"
                android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
                android:exported="false"
                />

        <activity
                android:name=".LicensesActivity"
                android:label="@string/settings_licenses"
                android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
                android:exported="false"
                />

        <activity
                android:name=".LicenseActivity"
                android:label="@string/settings_licenses"
                android:exported="false"
                />

        <activity
                android:name=".NotificationActivity"
                android:theme="@style/Theme.Tuxport.Terminal"
                android:exported="false"
                />

        <receiver
                android:name=".Notifications$ReportReceiver"
                android:exported="false"
                />

        <provider
                android:name=".DiagnosticProvider"
                android:authorities="${applicationId}.diagnostics"
                android:grantUriPermissions="true"
                android:exported="false">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/diagnostic_paths"
                    />
        </provider>

        <!-- The android/documents map: opt-in access to the home and whole system (read-only outside
             the home); only the system (the file picker, which holds MANAGE_DOCUMENTS) has direct access,
             other apps go through grants the user picks there -->
        <provider
                android:name=".Documents"
                android:authorities="${applicationId}.documents"
                android:permission="android.permission.MANAGE_DOCUMENTS"
                android:grantUriPermissions="true"
                android:exported="true">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- The android/service map: a specialUse foreground service is kept while sessions run -->
        <service
                android:name=".TerminalService"
                android:foregroundServiceType="specialUse"
                android:exported="false">
            <property
                    android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                    android:value="Runs the command-line programs that the user starts in a terminal session."
                    />
        </service>

    </application>

</manifest>
