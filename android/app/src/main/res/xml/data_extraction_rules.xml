<?xml version="1.0" encoding="utf-8"?>

<!-- The rootfs may be large and may not work on another device:
     no backup and no transfer between devices -->
<data-extraction-rules>

    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>

    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>

</data-extraction-rules>
